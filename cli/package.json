{
  "name": "nodetsp",
  "type": "module",
  "version": "2.0.0-beta.2",
  "description": "A starter for creating a TypeScript package.",
  "author": "Harsh Thakur <harshprojects2002@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/devharshthakur/nodetsp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devharshthakur/nodetsp.git"
  },
  "bugs": {
    "url": "https://github.com/devharshthakur/nodetsp/issues"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "bin": {
    "nodetsp": "dist/index.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown && node scripts/postbuild.js",
    "start": "node dist/index.mjs",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "format": "prettier --log-level silent --write \"**/*.{js,ts,tsx,md,json}\"",
    "clean": "rimraf dist",
    "prepublishOnly": "bun run build",
    "load": "bun run format && bun run build && bun link",
    "publish": "node scripts/publish.js"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "bumpp": "^11.0.1",
    "tsdown": "^0.21.4",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@clack/prompts": "^1.1.0",
    "commander": "^14.0.3",
    "picocolors": "^1.1.1"
  },
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  }
}
